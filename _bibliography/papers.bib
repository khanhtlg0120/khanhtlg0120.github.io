@article{trung2024, 
  title={WEAK HARNACK INEQUALITY FOR SCHRODINGER OPERATOR}, 
  volume={21}, 
  url={https://journal.hcmue.edu.vn/index.php/hcmuejos/article/view/4072}, 
  DOI={10.54607/hcmue.js.21.2.4072(2024)}, 
  abstractNote={In regularity theory, weak Harnack inequality play an important role. Weak Harnack inequality is necessary to prove Holder continuty of weak solution. In this paper, we prove weak Harnack inequality for Schrodinger operator which is crucial and has many applications in quantum mechanical physics, where A is a constant matrix and V is potental belong to Reverse Holder. To obtain that, we need estimate for fundamental solution, Fefferman-Phong’s inequality, Caccioppoli inequality and Friedrichs inequality. In paper of Shen Z. (1995), he established weak Harnack inequality for operator . The outcomes in our paper represent a generalization of the results presented in the paper of Shen Z. (1995).}, 
  number={2}, 
  journal={Ho Chi Minh City University of Education Journal of Science}, 
  author={Nguyen, Duc Trung and Nguyen, Trong Nhan and Truong, Le Gia Khanh and Nguyen, Ngoc Huu An and Nguyen, Thuy Tien}, 
  year={2024}, 
  month={Feb.}, 
  pages={256},
  category={undergrad}
}
